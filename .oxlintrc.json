{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc",
    "import",
    "jsx-a11y",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-duplicates": "error",
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-var": "error",
    "prefer-const": "error",
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.test.{js,jsx}",
        "src/setupTests.js",
        "src/test/**"
      ],
      "env": {
        "vitest": true
      },
      "rules": {
        "no-await-in-loop": "off",
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": [
              "expect",
              "inRange"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/**/*.mjs",
        "vite.config.js"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
