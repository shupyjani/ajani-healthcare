# EmailJS configuration for the contact form.
#
# Copy this file to `.env.local` and fill in the values from the EmailJS
# dashboard. `.env`, `.env.local` and every other real env file are ignored by
# git — never commit filled-in values.
#
# The EmailJS template must expose these five variables, which are the field
# names the contact form submits:
#   {{name}}  {{email}}  {{address}}  {{subject}}  {{message}}

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Ajani Mobile demo assistant (server-side only) --------------------------
#
# Read by the Netlify Function at netlify/functions/ajani-assistant.mjs and
# never by the browser. Set them in the Netlify UI under Site configuration →
# Environment variables, NOT in a VITE_ variable: anything prefixed VITE_ is
# inlined into the client bundle and would publish the credential.
#
# Both are optional. With neither set the endpoint replies `fallback: true` and
# the demo answers from its own built-in guidance, which is the intended public
# behaviour rather than a degraded one.
#
# OPENAI_MODEL is a Responses API model id.

OPENAI_API_KEY=
OPENAI_MODEL=
